{
  "productName": "RustZap",
  "version": "0.1.0",
  "identifier": "br.com.erlondnjr.rustzap",
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}