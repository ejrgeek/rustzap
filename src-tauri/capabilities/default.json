{
  "identifier": "default",
  "description": "Permissões padrão para o RustZap",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:default",
    "core:webview:default",
    "core:menu:default",
    "core:event:default",
    "window-state:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus"
  ]
}